{
  "name": "what-to-watch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/db/migrate.ts",
    "ml:backfill": "tsx --env-file-if-exists=.env.local src/lib/ml/runBackfill.ts",
    "tmdb:backfill": "tsx --env-file-if-exists=.env.local src/lib/tmdb/runBackfill.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@node-rs/argon2": "^2.1.0",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
