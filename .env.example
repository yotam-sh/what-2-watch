# Copy this file to .env.local for local development (Next.js loads that
# automatically) or .env for `docker compose --env-file .env` in production.
# Every variable here is validated at startup by src/lib/env.ts — the app
# will refuse to start and print exactly what's wrong/missing rather than
# fail confusingly later.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# AES-256 key for the "serverVault" encryption scope (src/lib/crypto/serverVault.ts)
# AND the SQLCipher key for the entire database file (src/db/client.ts,
# src/db/sqlcipherKey.ts) — every table is encrypted at rest under this key,
# not just the serverVault-encrypted columns.
#
# THIS KEY IS NOW LOAD-BEARING FOR DATA RECOVERY, NOT JUST CONFIDENTIALITY.
# Losing it means losing the entire database — there is no recovery path, by
# design. A backup that contains the .db file but not this key protects
# nothing; a backup of this key alone without the .db file is useless too.
# Back up both, together, and treat the key with the same care as the data
# it protects. See README.md > "Encryption at rest" before rotating it or
# restoring from backup.
#
# Must be base64 and decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_ENCRYPTION_KEY=

# Signing secret for session JWTs (src/lib/auth/jwt.ts). At least 32 characters.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# TMDB v3 API key — used for metadata enrichment starting in Phase 3, but
# validated now so a misconfigured deploy fails at boot, not mid-sync.
# Get one at https://www.themoviedb.org/settings/api (free, instant).
TMDB_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Node environment. "development" | "production" | "test". Defaults to
# "development" if unset — Next.js also sets this itself during
# `next build`/`next start`, so you usually don't need to set it by hand.
NODE_ENV=development

# Whether the session cookie gets the `secure` flag (src/lib/auth/cookies.ts).
# MUST be "false" for local http://localhost dev — browsers silently drop
# `secure` cookies over plain http, which would make login look like it
# succeeds but the session never sticks. Set to "true" once this is served
# over https (i.e. behind the Cloudflare Tunnel in production).
SECURE_COOKIES=false

# Optional Tautulli enrichment (Phase 2). Leave both unset if you don't run
# Tautulli — it's detected at config time and never required. If you do:
# TAUTULLI_URL is the base URL (e.g. http://192.168.1.10:30047) and
# TAUTULLI_API_KEY is found in Tautulli under Settings > Web Interface > API.
TAUTULLI_URL=
TAUTULLI_API_KEY=

# Where src/lib/ml/embed.ts loads the ML embedding model (Xenova/all-MiniLM-L6-v2)
# from — local disk only, never the network, once NODE_ENV=production (a home
# NAS may have flaky/no connectivity). Defaults to `<cwd>/models` if unset,
# which is already correct for local dev (`npm run ml:backfill` downloads the
# model there on first run, since NODE_ENV isn't "production" locally) and for
# Docker (the Dockerfile bakes the model into the image at exactly that path
# and also sets this explicitly). You only need to set this yourself if you
# want the model somewhere non-default.
ML_MODEL_DIR=

# ---------------------------------------------------------------------------
# Docker Compose only — NOT read by the Next.js app itself (src/lib/env.ts
# doesn't validate these). Used by docker-compose.yml's `cloudflared`
# service and by an image tag override, respectively. See README.md
# "Docker / deploy" and "Cloudflare Tunnel setup".
# ---------------------------------------------------------------------------

# Cloudflare Tunnel connector token: Zero Trust dashboard > Networks >
# Tunnels > Create a tunnel > Docker. A long opaque string cloudflared
# decodes itself — not an API token, don't confuse the two. Required for
# `docker compose up` to bring the `cloudflared` service up successfully;
# the `app` service works without it.
TUNNEL_TOKEN=
